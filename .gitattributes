# Graphify knowledge graph artifacts are generated by `graphify update .`.
# They are versioned so agents share one map of the codebase, but they are not
# meant to be reviewed or merged by hand - regenerate instead of resolving.
graphify-out/graph.json  -diff linguist-generated=true
graphify-out/graph.html  -diff linguist-generated=true
graphify-out/GRAPH_REPORT.md linguist-generated=true
